#------------Find out the Fraud Transactions and their Name -------------------------------------------------


SELECT c.cust_name,t.transaction_amount,f.fraud_reason
FROM Customers c 
JOIN Accounts a 
ON c.cust_id = a.cust_id 
JOIN Transactions t
ON a.account_id = t.account_id
JOIN Fraud_alert f 
ON t.Transaction_id = f.Transaction_id
WHERE Fraud_reason <> "Normal";

#--------------find out the normal transactions customers----------

SELECT c.cust_name,t.transaction_amount,f.fraud_reason
FROM Customers c 
JOIN Accounts a 
ON c.cust_id = a.cust_id 
JOIN Transactions t
ON a.account_id = t.account_id
JOIN Fraud_alert f 
ON t.Transaction_id = f.Transaction_id
WHERE Fraud_reason = "Normal";



SELECT COUNT(*) Fraud_reason
FROM Fraud_alert
WHERE Fraud_reason = "Normal";



#-------------Customers with No Fraud History-----------


SELECT c.cust_id,
       c.cust_name,
       f.fraud_reason,
       CASE
           WHEN f.fraud_reason = "Normal" THEN "None"
           ELSE f.fraud_reason
           END AS fraud_reason
FROM Customers c
JOIN Accounts a
ON c.cust_id = a.cust_id
JOIN Transactions t
ON a.account_id = t.account_id
LEFT JOIN Fraud_Alert f
ON t.transaction_id = f.transaction_id
WHERE fraud_reason = "Normal"; 



#--------------------Average Transaction Amount by City-----------------



SELECT c.cust_city,
       ROUND(AVG(t.transaction_amount)) Avg_Amount
FROM Customers c
JOIN Accounts a
ON c.cust_id = a.cust_id
JOIN Transactions t
ON a.account_id = t.account_id
GROUP BY c.cust_city;


#--------------------Customers Making High-Value Transactions------------------


SELECT c.cust_name,
       t.transaction_amount
FROM Customers c
JOIN Accounts a
ON c.cust_id = a.cust_id
JOIN Transactions t
ON a.account_id = t.account_id
WHERE t.transaction_amount > 50000
ORDER BY Transaction_amount DESC;


#------Highest Fraud-Prone Location----------------


SELECT t.transaction_location,
       COUNT(*) AS Fraud_Count
FROM Transactions t
JOIN Fraud_Alert f
ON t.transaction_id = f.transaction_id
WHERE f.fraud_reason <> 'Normal'
GROUP BY t.transaction_location
ORDER BY Fraud_Count DESC;



#--------Find the Customer Risk Score---------------------


SELECT c.cust_name,
       COUNT(f.transaction_id) AS Fraud_Count,
       CASE
           WHEN COUNT(f.transaction_id) >= 2 THEN 'High Risk'
           WHEN COUNT(f.transaction_id) >= 1 THEN 'Medium Risk'
           ELSE 'Low Risk'
       END AS Risk_Level
FROM Customers c
JOIN Accounts a
ON c.cust_id = a.cust_id
JOIN Transactions t
ON a.account_id = t.account_id
LEFT JOIN Fraud_Alert f
ON t.transaction_id = f.transaction_id
AND f.fraud_reason <> 'Normal'
GROUP BY c.cust_name;



#-------Which Location Generates the Transaction_amount---------------


SELECT
    transaction_location,
    SUM(transaction_amount) AS Total_transaction_amount
FROM Transactions
GROUP BY transaction_location
ORDER BY Total_transaction_amount DESC;
