FROM Customers c 
JOIN Accounts a 
ON  c.cust_id = a.cust_id
ORDER BY account_balance DESC
LIMIT 5;

#-------------Using Window Functions to Find the Top 5 Customers Account balance-----------------------------
      
 WITH CustomerRank AS (
    SELECT *,
           ROW_NUMBER() OVER (ORDER BY Account_Balance DESC) AS rn
    FROM Accounts
)
SELECT *
FROM CustomerRank
WHERE rn <= 5;
 
